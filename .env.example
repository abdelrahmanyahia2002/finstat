# ---- Database ----
DATABASE_URL="postgresql://finstat:finstat@localhost:5433/finstat?schema=public"

# ---- Redis (BullMQ) ----
REDIS_HOST=localhost
REDIS_PORT=6380

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- API ----
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
FILE_STORAGE_DIR=./storage

# ---- Seed admin (created by npm run db:seed) ----
SEED_ADMIN_EMAIL=admin@finstat.local
SEED_ADMIN_PASSWORD=Admin123!

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
